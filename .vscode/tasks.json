{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "git fetch all prune",
			"type": "shell",
			"command": "git",
			"args": [
				"fetch",
				"--all",
				"--prune"
			]
		},
		{
			"label": "git fetch and pull",
			"type": "shell",
			"command": "git fetch --all --prune && git pull --rebase --autostash"
		}
	]
}